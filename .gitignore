# =============================================================================
# REPROX Monorepo Root .gitignore
# =============================================================================

# Environment & Secrets (Never commit live credentials)
.env
*.env
!.env.example
.env.local
.env.*.local

# Python & Django
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
venv/
.venv/
ENV/
env/
*.sqlite3
db.sqlite3-journal

# Node.js & Vite Frontend
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
.vite/
frontend/.vite/
*.local

# Playwright & Testing Artifacts
test-results/
playwright-report/
blob-report/
playwright/.cache/
frontend/test-results/
frontend/playwright-report/

# Logs & Diagnostics
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor & OS Artifacts
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
