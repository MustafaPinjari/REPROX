# =============================================================================
# REPROX Root Environment Configuration Template
# Copy to .env and customize for your local or production environment
# =============================================================================

# Django Backend Configuration
DJANGO_SECRET_KEY=reprox-hackathon-insecure-key-2026-prod-grade
DJANGO_DEBUG=True
DJANGO_PORT=8000
DATABASE_ENGINE=sqlite3

# Frontend Application Configuration
FRONTEND_PORT=3000
VITE_API_URL=http://127.0.0.1:8000/api
FRONTEND_URL=http://127.0.0.1:3000

# Wispr Flow Acoustic Speech-to-Intent Pipeline
# Obtain from https://wisprflow.ai / Wispr Flow developer console
WISPR_FLOW_API_KEY=your_wispr_flow_api_key_here
WISPR_FLOW_ENDPOINT=https://api.wisprflow.ai/v1

# Playwright Subprocess Runner
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_BROWSER_CHANNEL=msedge
